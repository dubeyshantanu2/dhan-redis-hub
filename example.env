# =================================================================
# DHAN REDIS HUB — ENVIRONMENT CONFIGURATION
# =================================================================

# -----------------------------------------------------------------
# Redis Cache Configuration
# -----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------
# Supabase Authentication Sync (api_keys provider='DHAN')
# -----------------------------------------------------------------
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------
# Discord System Health & Error Webhook Logging
# -----------------------------------------------------------------
DISCORD_HEALTH_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
DISCORD_WEBHOOK_URL=

# -----------------------------------------------------------------
# Dhan API v2 Endpoints
# -----------------------------------------------------------------
DHAN_API_BASE=https://api.dhan.co/v2
DHAN_WS_URL=wss://api-feed.dhan.co

# -----------------------------------------------------------------
# Rate Governor Thresholds (Min Interval in Seconds per Category)
# -----------------------------------------------------------------
RATE_LIMIT_OPTION_CHAIN_SECS=1.0
RATE_LIMIT_QUOTE_SECS=0.5
RATE_LIMIT_CANDLES_SECS=1.0

# -----------------------------------------------------------------
# Redis Cache Time-To-Live (TTL in Seconds)
# -----------------------------------------------------------------
TTL_OPTION_CHAIN_MARKET=2
TTL_OPTION_CHAIN_OFFMARKET=60
TTL_QUOTE=5
TTL_EXPIRY_LIST=43200
TTL_CANDLES_INTRADAY=900
TTL_CANDLES_DAILY=86400
TTL_SCRIP_MASTER=86400
# Last-tick snapshot written by the WebSocket hub (dhan:tick:<id>).
# Deliberately separate from dhan:quote:<id>, which the REST poller owns.
TTL_TICK_SNAPSHOT=60

# ---- WebSocket Feed (TASK-006) ----
# Comma-separated futures symbols subscribed at Full mode (5-level depth +
# volume + OI). Contract IDs resolve from the scrip master at connect time,
# so the monthly roll needs no edit here.
WS_FUTURES_SYMBOLS=NIFTY
# Reconnect backoff: starts at initial, doubles to max, resets after a
# connection has held for reset_after seconds.
WS_INITIAL_BACKOFF_SECS=1.0
WS_MAX_BACKOFF_SECS=60.0
WS_BACKOFF_RESET_AFTER_SECS=60.0
PROJECT_NAME=unknown-project
